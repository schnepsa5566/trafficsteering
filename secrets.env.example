# Kopieren nach secrets.env und Werte eintragen.
# secrets.env wird NICHT ins Git eingecheckt (.gitignore).
# Umgebungsvariablen gleichen Namens haben Vorrang.
#
# Der API-Key benötigt die Scopes:
#   deployments.internaldomains:read
#   deployments.internaldomains:write
#
# urlCheck.py (Kategorisierung über die Investigate API) benötigt:
#   investigate.investigate:read
CISCO_SECURE_ACCESS_KEY=
CISCO_SECURE_ACCESS_SECRET=
